# Local configuration for AM3359 custom board
# Yocto Project 5.2 Poky distribution [walnascar] branch

DISTRO_FEATURES = "ext2 security systemd usbhost ${DISTRO_FEATURES_LIBC}"

DISTRO_FEATURES_BACKFILL_CONSIDERED += "pulseaudio sysvinit"

DISTRO_FEATURES:remove = "ptest"

INIT_MANAGER = "systemd"

# 使用AM3359机器配置
MACHINE = "am3359"

# 根据您的板子修改设备树文件
# 如果使用标准BeagleBone设备树，可以使用：
# KERNEL_DTB = "am335x-boneblack.dtb"
# 如果需要自定义设备树，请指定您的设备树文件名
KERNEL_DTB = "am335x-boneblack.dtb"

# SD卡启动配置
# 构建最小镜像用于SD卡启动
# bitbake core-image-minimal-sdcard

PREFERRED_PROVIDER_virtual/kernel = "linux-stable"

#DL_DIR = "/src/walnascar"
#SSTATE_DIR = "/oe5/bbb/sstate-cache"
#TMPDIR = "/oe5/bbb/tmp"

DISTRO = "poky"
PACKAGE_CLASSES = "package_ipk"

SDKMACHINE = "x86_64"

EXTRA_IMAGE_FEATURES = "empty-root-password allow-empty-password allow-root-login"

PATCHRESOLVE = "noop"
RM_OLD_IMAGE = "1"
INHERIT += "rm_work"
CONF_VERSION = "2"

